1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="agreg"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint x="14" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="agreg_l1" value="1..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="agreg"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint x="20" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="agreg_l2" value="agrupa" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="agreg"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="30" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="her_inteira" style="endArrow=block;endFill=0;edgeStyle=orthogonalEdgeStyle;endSize=16;html=1;rounded=0;fontSize=12;endSize=14;startSize=16;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="inteira" target="ingresso"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610.0" y="293"/><mxPoint x="725.0" y="293"/></Array></mxGeometry></mxCell><mxCell id="her_meia" style="endArrow=block;endFill=0;edgeStyle=orthogonalEdgeStyle;endSize=16;html=1;rounded=0;fontSize=12;endSize=14;startSize=16;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="meia" target="ingresso"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865.0" y="293"/><mxPoint x="725.0" y="293"/></Array></mxGeometry></mxCell><mxCell id="dep_status" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=12;endSize=14;startSize=16;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="venda" target="status"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_venda" value="&lt;b&gt;Estado da Venda&lt;/b&gt;&lt;br&gt;Só muda por operação:&lt;br&gt;ABERTA → PAGA (pagar())&lt;br&gt;ABERTA → CANCELADA (cancelar())&lt;br&gt;Cancelar libera os assentos e descarta os ingressos (composição)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;spacingLeft=8;spacingRight=6;fillColor=#fff9db;strokeColor=#b59f3b;fontSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="105" y="590" width="300" height="124" as="geometry"/></mxCell><mxCell id="n_venda_e" style="endArrow=none;dashed=1;html=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="n_venda" target="status"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_sessao" value="&lt;b&gt;Regra inegociável&lt;/b&gt;&lt;br&gt;venderAssento() recusa um assento que já está em assentosVendidos: o mesmo assento não é vendido duas vezes na mesma sessão. Quem chama é o construtor do Ingresso." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;spacingLeft=8;spacingRight=6;fillColor=#fff9db;strokeColor=#b59f3b;fontSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1435" y="150" width="230" height="140" as="geometry"/></mxCell><mxCell id="n_sessao_e" style="endArrow=none;dashed=1;html=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="n_sessao" target="sessao"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_preco" value="&lt;b&gt;Encapsulamento&lt;/b&gt;&lt;br&gt;preco é privado e não tem setPreco(); o construtor recusa valor negativo.&lt;br&gt;IngressoMeia.calcularPreco() = metade do preço (exige comprovante)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;spacingLeft=8;spacingRight=6;fillColor=#fff9db;strokeColor=#b59f3b;fontSize=12;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="730" y="650" width="290" height="90" as="geometry"/></mxCell><mxCell id="n_preco_e" style="endArrow=none;dashed=1;html=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="n_preco" target="meia"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>